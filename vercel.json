{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.sanity.io; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en/artigos/voltar-a-um-projeto-depois-de-semanas/",
      "destination": "/en/artigos/return-to-a-project-after-weeks/",
      "permanent": true
    },
    {
      "source": "/en/artigos/quando-preparar-demais-adia-o-comeco/",
      "destination": "/en/artigos/when-preparation-delays-the-start/",
      "permanent": true
    },
    {
      "source": "/en/artigos/guardar-o-fio-da-meada-antes-de-pausar/",
      "destination": "/en/artigos/keep-the-thread-before-a-pause/",
      "permanent": true
    },
    {
      "source": "/es/artigos/voltar-a-um-projeto-depois-de-semanas/",
      "destination": "/es/artigos/volver-a-un-proyecto-despues-de-semanas/",
      "permanent": true
    },
    {
      "source": "/es/artigos/quando-preparar-demais-adia-o-comeco/",
      "destination": "/es/artigos/cuando-preparar-demasiado-retrasa-el-comienzo/",
      "permanent": true
    },
    {
      "source": "/es/artigos/guardar-o-fio-da-meada-antes-de-pausar/",
      "destination": "/es/artigos/guardar-el-hilo-antes-de-una-pausa/",
      "permanent": true
    },
    {
      "source": "/de/artigos/voltar-a-um-projeto-depois-de-semanas/",
      "destination": "/de/artigos/nach-wochen-zu-einem-projekt-zurueckkehren/",
      "permanent": true
    },
    {
      "source": "/de/artigos/quando-preparar-demais-adia-o-comeco/",
      "destination": "/de/artigos/wenn-vorbereitung-den-anfang-verzoegert/",
      "permanent": true
    },
    {
      "source": "/de/artigos/guardar-o-fio-da-meada-antes-de-pausar/",
      "destination": "/de/artigos/vor-einer-pause-den-faden-bewahren/",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/pt-br/",
      "permanent": false
    }
  ]
}
