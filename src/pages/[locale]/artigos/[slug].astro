---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getMessages } from '../../../i18n/messages';
import { getPageCopy } from '../../../i18n/pages';
import { isLocale, publishedLocales } from '../../../i18n/config';
import { getEditorialCatalog } from '../../../content/editorial';
import type { Locale } from '../../../i18n/config';

export async function getStaticPaths() {
  const catalog = await getEditorialCatalog();
  return publishedLocales.flatMap((locale) =>
    catalog[locale].map((article) => {
      const localizedPaths = Object.fromEntries(
        publishedLocales.flatMap((target) => {
          const translation = catalog[target].find(
            (candidate) => candidate.translationKey === article.translationKey,
          );
          return translation ? [[target, `/${target}/artigos/${translation.slug}/`]] : [];
        }),
      ) as Partial<Record<Locale, string>>;
      return {
        params: { locale, slug: article.slug },
        props: {
          article,
          localizedPaths,
          relatedArticles: catalog[locale]
            .filter((candidate) => candidate.translationKey !== article.translationKey)
            .slice(0, 2),
        },
      };
    }),
  );
}

const rawLocale = Astro.params.locale;
if (!isLocale(rawLocale)) return Astro.redirect('/pt-br/artigos/');
const locale = rawLocale;
const copy = getMessages(locale);
const pages = getPageCopy(locale);
const { article, localizedPaths, relatedArticles } = Astro.props;
const articleUrl = new URL(Astro.url.pathname, Astro.site).href;
const dateLocale = locale === 'pt-br' ? 'pt-BR' : locale;
const formatDate = (value: string) =>
  new Intl.DateTimeFormat(dateLocale, { day: 'numeric', month: 'long', year: 'numeric' }).format(
    new Date(`${value}T12:00:00Z`),
  );
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.summary,
  author: { '@type': 'Organization', name: article.author },
  publisher: { '@type': 'Organization', name: 'DoItBad' },
  datePublished: article.publishedAt,
  dateModified: article.reviewedAt,
  inLanguage: locale,
  mainEntityOfPage: articleUrl,
  image: new URL(article.cover.src, Astro.site).href,
};
---

<BaseLayout
  locale={locale}
  title={`${article.title} — DoItBad`}
  description={article.summary}
  type="article"
  structuredData={structuredData}
  localizedPaths={localizedPaths}
  image={article.cover.src}
>
  <Header locale={locale} copy={copy} localizedPaths={localizedPaths} />
  <main class="article-page" id="conteudo">
    <article class="article-reader shell">
      <a class="back-link" href={`/${locale}/artigos/`}>
        ← {pages.editorial.all}
      </a>
      <header class="article-header">
        <div class="article-header__copy">
          <p class="eyebrow">
            <span></span>
            {article.category} · {article.readingTime}
          </p>
          <h1>{article.title}</h1>
          <p class="article-lede">{article.summary}</p>
          <p class="article-meta">
            {article.author} ·{' '}
            <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
          </p>
        </div>
        <figure class="article-cover">
          <img src={article.cover.src} alt={article.cover.alt} width="1280" height="853" />
        </figure>
      </header>
      <div class="article-content">
        <aside class="article-aside" aria-hidden="true">
          <span>✦</span>
          <i></i>
        </aside>
        <div class="article-body">
          {article.paragraphs.map((paragraph, index) => (
            <p class:list={{ 'article-body__opening': index === 0 }}>{paragraph}</p>
          ))}
          <aside class="article-action">
            <strong>{pages.demo.now}</strong>
            <p>{article.action}</p>
          </aside>
          <a class="button" href={`/${locale}/artigos/`}>
            {pages.editorial.another}
          </a>
        </div>
      </div>
      <aside class="related-articles" aria-labelledby="related-title">
        <h2 id="related-title">{pages.editorial.related}</h2>
        <div>
          {relatedArticles.map((related) => (
            <a href={`/${locale}/artigos/${related.slug}/`}>
              <span>
                {related.category} · {related.readingTime}
              </span>
              <strong>{related.title}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </aside>
    </article>
  </main>
  <Footer locale={locale} copy={copy} />
</BaseLayout>
