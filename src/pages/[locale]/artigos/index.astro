---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getMessages } from '../../../i18n/messages';
import { getPageCopy } from '../../../i18n/pages';
import { isLocale, publishedLocales } from '../../../i18n/config';
import { getArticles } from '../../../content/editorial';

export function getStaticPaths() {
  return publishedLocales.map((locale) => ({ params: { locale } }));
}

const rawLocale = Astro.params.locale;
if (!isLocale(rawLocale)) return Astro.redirect('/pt-br/artigos/');
const locale = rawLocale;
const copy = getMessages(locale);
const pages = getPageCopy(locale);
const articles = await getArticles(locale);
---

<BaseLayout
  locale={locale}
  title={`${pages.editorial.title} — DoItBad`}
  description={copy.journal.body}
>
  <Header locale={locale} copy={copy} />
  <main class="editorial-page" id="conteudo">
    <header class="editorial-hero shell">
      <div>
        <p class="eyebrow">
          <span></span>
          {pages.editorial.title}
        </p>
        <h1>{pages.editorial.heading}</h1>
      </div>
      <div class="editorial-hero__intro">
        <p>{pages.editorial.intro}</p>
        <span aria-hidden="true">↘</span>
      </div>
    </header>
    <section class="article-index shell" aria-label={pages.editorial.list}>
      {articles.map((article, index) => (
        <a
          class:list={['article-index-card', { 'article-index-card--featured': index === 0 }]}
          href={`/${locale}/artigos/${article.slug}/`}
        >
          <figure class="article-index-art">
            <img
              src={article.cover.src}
              alt={article.cover.alt}
              width="1280"
              height="853"
              loading={index ? 'lazy' : 'eager'}
            />
            <span aria-hidden="true">0{index + 1}</span>
          </figure>
          <div class="article-index-card__copy">
            <p class="article-kicker">
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </p>
            <h2>{article.title}</h2>
            <p>{article.summary}</p>
            <span class="article-index-link">
              {pages.editorial.read} <span aria-hidden="true">↗</span>
            </span>
          </div>
        </a>
      ))}
    </section>
  </main>
  <Footer locale={locale} copy={copy} />
</BaseLayout>
