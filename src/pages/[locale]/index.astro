---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StepDemo from '../../components/StepDemo';
import TeamSection from '../../components/TeamSection.astro';
import CharacterSketch from '../../components/CharacterSketch.astro';
import FaqSection from '../../components/FaqSection.astro';
import IntroRive from '../../components/IntroRive';
import { getArticles } from '../../content/editorial';
import { getMessages } from '../../i18n/messages';
import { getPageCopy } from '../../i18n/pages';
import { isLocale, publishedLocales } from '../../i18n/config';

export function getStaticPaths() {
  return publishedLocales.map((locale) => ({ params: { locale } }));
}

const rawLocale = Astro.params.locale;
if (!isLocale(rawLocale)) return Astro.redirect('/pt-br/');
const locale = rawLocale;
const copy = getMessages(locale);
const pages = getPageCopy(locale);
const articles = await getArticles(locale);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout
  locale={locale}
  title={copy.meta.title}
  description={copy.meta.description}
  cinematicIntro
>
  <Header locale={locale} copy={copy} />
  <IntroRive client:load />
  <main id="conteudo">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow">
          <span></span>
          {copy.hero.eyebrow}
        </p>
        <h1 id="hero-title">
          {copy.hero.titleStart}
          <br />
          <em>{copy.hero.titleAccent}</em>
        </h1>
        <p class="lede">{copy.hero.body}</p>
        <div class="button-row">
          <a class="button" href="#acompanhar">
            {copy.hero.primary}
          </a>
          <a class="text-link" href="#experiencia">
            {copy.hero.secondary}
            <span aria-hidden="true">↘</span>
          </a>
        </div>
        <p class="hero-note">
          <i aria-hidden="true"></i>
          {copy.hero.note}
        </p>
      </div>
      <div class="hero-art" data-reveal aria-hidden="true">
        <div class="hero-orbit"></div>
        <div class="hero-sun">✦</div>
        <div class="paper-card paper-card--back">
          <span>um respiro</span>
          <b>
            antes
            <br />
            do passo
          </b>
        </div>
        <div class="paper-card paper-card--front">
          <span>agora</span>
          <div class="mini-path">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <b>
            Abra apenas
            <br />o arquivo.
          </b>
          <small>isso já conta.</small>
        </div>
        <svg class="hero-thread" viewBox="0 0 620 660" fill="none">
          <path d="M6 609C103 522 48 404 167 380C287 356 185 251 313 228C441 204 383 78 599 35" />
        </svg>
        <div class="clay clay--one"></div>
        <div class="clay clay--two"></div>
        <CharacterSketch />
      </div>
    </section>

    <section class="recognition" id="experiencia">
      <div class="shell recognition-grid" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">
            <span></span>
            {copy.recognition.eyebrow}
          </p>
          <h2>{copy.recognition.title}</h2>
        </div>
        <div class="recognition-copy">
          <p>{copy.recognition.body}</p>
          <ol>
            {copy.recognition.moments.map((moment, index) => (
              <li>
                <span>0{index + 1}</span>
                {moment}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="step-demo shell" data-reveal aria-labelledby="step-title">
      <div class="step-copy">
        <p class="eyebrow">
          <span></span>
          {copy.step.eyebrow}
        </p>
        <h2 id="step-title">{copy.step.title}</h2>
        <p class="quiet">{pages.demo.reassurance}</p>
      </div>
      <StepDemo copy={pages.demo} client:load />
    </section>

    <section class="return-section" aria-labelledby="return-title">
      <div class="stars" aria-hidden="true">
        ✦ · ✧ · ✦
      </div>
      <div class="shell return-grid" data-reveal>
        <div>
          <p class="eyebrow eyebrow--light">
            <span></span>
            {copy.return.eyebrow}
          </p>
          <h2 id="return-title">{copy.return.title}</h2>
          <p>{copy.return.body}</p>
        </div>
        <article class="return-card">
          <span>{copy.return.cardOverline}</span>
          <div class="moon" aria-hidden="true"></div>
          <h3>{copy.return.cardTitle}</h3>
          <p>{copy.return.cardBody}</p>
          <a href="#acompanhar">
            {copy.return.cardAction}
            <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
      <div class="night-hills" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </div>
    </section>

    <section class="ecosystem shell" id="ecossistema" aria-labelledby="ecosystem-title">
      <div class="section-heading section-heading--center" data-reveal>
        <p class="eyebrow">
          <span></span>
          {copy.ecosystem.eyebrow}
        </p>
        <h2 id="ecosystem-title">{copy.ecosystem.title}</h2>
        <p>{copy.ecosystem.body}</p>
      </div>
      <div class="device-line" aria-hidden="true">
        <span></span>
      </div>
      <div class="ecosystem-grid" data-reveal>
        {copy.ecosystem.items.map((item, index) => (
          <article>
            <div class={`device device--${index}`}>
              <i></i>
            </div>
            <span>{copy.ecosystem.status}</span>
            <h3>{item.name}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="journal" id="conteudo-editorial">
      <div class="shell" data-reveal>
        <div class="journal-heading">
          <div>
            <p class="eyebrow">
              <span></span>
              {copy.journal.eyebrow}
            </p>
            <h2>{copy.journal.title}</h2>
          </div>
          <p>{copy.journal.body}</p>
        </div>
        <div class="journal-grid">
          {copy.journal.posts.map((post, index) => (
            <a class="journal-card" href={`/${locale}/artigos/${articles[index].slug}/`}>
              <div class="article-art">
                <img
                  src={articles[index].cover.src}
                  alt={articles[index].cover.alt}
                  width="1280"
                  height="853"
                  loading="lazy"
                />
              </div>
              <small>
                0{index + 1} · {copy.journal.read}
              </small>
              <h3>{post}</h3>
              <span class="article-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <div data-reveal>
      <TeamSection copy={pages.team} />
    </div>

    <div data-reveal>
      <FaqSection
        title={pages.faqTitle}
        eyebrow={pages.faqEyebrow}
        intro={pages.faqIntro}
        questions={pages.faqs}
      />
    </div>

    <section class="waitlist shell" data-reveal id="acompanhar" aria-labelledby="waitlist-title">
      <div class="waitlist-art" aria-hidden="true">
        <div class="arch"></div>
        <div class="sprout">⌇</div>
        <div class="spark">✦</div>
      </div>
      <div class="waitlist-copy">
        <p class="eyebrow">
          <span></span>
          {copy.waitlist.eyebrow}
        </p>
        <h2 id="waitlist-title">{copy.waitlist.title}</h2>
        <p>{copy.waitlist.body}</p>
        <form
          class="waitlist-form"
          data-waitlist-form
          data-success={copy.waitlist.success}
          data-duplicate={copy.waitlist.duplicate}
          data-error={copy.waitlist.error}
        >
          <label>
            <span>{copy.waitlist.name}</span>
            <input
              name="name"
              autocomplete="name"
              placeholder={copy.waitlist.name}
              maxlength="80"
            />
          </label>
          <label>
            <span>{copy.waitlist.email}</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              placeholder={copy.waitlist.email}
              required
              maxlength="254"
            />
          </label>
          {turnstileSiteKey && (
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-action="waitlist"
              data-size="flexible"
            ></div>
          )}
          <button class="button" type="submit">
            {copy.waitlist.button}
          </button>
          <p class="form-status" data-form-status aria-live="polite"></p>
        </form>
        <p class="form-note">{copy.waitlist.disclaimer}</p>
      </div>
    </section>
  </main>
  <Footer locale={locale} copy={copy} />
  {turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  )}
  <script>
    const form = document.querySelector<HTMLFormElement>('[data-waitlist-form]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const fields = new FormData(form);

      if (!button || !status) return;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      status.dataset.state = '';
      status.textContent = '';

      try {
        const response = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: fields.get('name'),
            email: fields.get('email'),
            locale: document.documentElement.lang,
            turnstileToken: fields.get('cf-turnstile-response'),
          }),
        });
        const result = (await response.json()) as { ok?: boolean; duplicate?: boolean };
        if (!response.ok || !result.ok) throw new Error('request_failed');

        status.dataset.state = 'success';
        status.textContent = result.duplicate ? form.dataset.duplicate! : form.dataset.success!;
        form.reset();
        window.turnstile?.reset();
      } catch {
        status.dataset.state = 'error';
        status.textContent = form.dataset.error!;
        window.turnstile?.reset();
      } finally {
        button.disabled = false;
        form.removeAttribute('aria-busy');
      }
    });
  </script>
</BaseLayout>
