---
interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  questions: readonly (readonly [string, string])[];
}
const { title, eyebrow, intro, questions } = Astro.props;
---

<section class="faq shell" id="perguntas" aria-labelledby="faq-title">
  <div class="faq-intro">
    <p class="eyebrow">
      <span></span>
      {eyebrow}
    </p>
    <h2 id="faq-title">{title}</h2>
    <p>{intro}</p>
  </div>
  <div class="faq-list">
    {questions.map((item, index) => (
      <details open={index === 0}>
        <summary>
          {item[0]}
          <span aria-hidden="true">+</span>
        </summary>
        <p>{item[1]}</p>
      </details>
    ))}
  </div>
</section>
