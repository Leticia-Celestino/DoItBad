---
import Brand from './ui/Brand.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { localeLabels, locales, publishedLocales, type Locale } from '../i18n/config';
import type { Messages } from '../i18n/messages';
import { getPageCopy } from '../i18n/pages';
interface Props {
  locale: Locale;
  copy: Messages;
  localizedPaths?: Partial<Record<Locale, string>>;
}
const { locale, copy, localizedPaths } = Astro.props;
const pages = getPageCopy(locale);
const localizedPath = (target: Locale) =>
  localizedPaths?.[target] ?? Astro.url.pathname.replace(/^\/(pt-br|en|es|de)(?=\/)/, `/${target}`);
const home = `/${locale}/`;
const menuLabels: Record<Locale, { navigation: string; open: string; label: string }> = {
  'pt-br': { navigation: 'Navegação principal', open: 'Abrir menu de navegação', label: 'Menu' },
  en: { navigation: 'Main navigation', open: 'Open navigation menu', label: 'Menu' },
  es: { navigation: 'Navegación principal', open: 'Abrir menú de navegación', label: 'Menú' },
  de: { navigation: 'Hauptnavigation', open: 'Navigationsmenü öffnen', label: 'Menü' },
};
const menu = menuLabels[locale];
---

<header class="site-header">
  <div class="shell header-inner">
    <Brand locale={locale} />
    <nav class="desktop-nav" aria-label={menu.navigation}>
      <a href={`${home}#experiencia`}>{copy.nav.experience}</a>
      <a href={`${home}#ecossistema`}>{copy.nav.ecosystem}</a>
      <a href={`${home}#equipe`}>{pages.team[0]}</a>
      <a href={`${home}#perguntas`}>FAQ</a>
      <a href={`/${locale}/artigos/`}>{copy.nav.journal}</a>
    </nav>
    <div class="header-actions">
      <details class="locale-picker">
        <summary aria-label="Selecionar idioma">
          {localeLabels[locale]} <span aria-hidden="true">⌄</span>
        </summary>
        <div>
          {locales.map((item) =>
            publishedLocales.includes(item) ? (
              <a href={localizedPath(item)} aria-current={item === locale ? 'page' : undefined}>
                {localeLabels[item]}
              </a>
            ) : (
              <span title="Tradução em preparação">{localeLabels[item]}</span>
            ),
          )}
        </div>
      </details>
      <ThemeToggle lightLabel={copy.theme.light} darkLabel={copy.theme.dark} />
      <a class="button button--small" href={`${home}#acompanhar`}>
        {copy.nav.cta}
      </a>
      <details class="mobile-nav">
        <summary aria-label={menu.open}>
          <span>{menu.label}</span>
          <i aria-hidden="true"></i>
        </summary>
        <div class="mobile-nav__panel">
          <nav aria-label={menu.navigation}>
            <a href={`${home}#experiencia`}>{copy.nav.experience}</a>
            <a href={`${home}#ecossistema`}>{copy.nav.ecosystem}</a>
            <a href={`${home}#equipe`}>{pages.team[0]}</a>
            <a href={`${home}#perguntas`}>FAQ</a>
            <a href={`/${locale}/artigos/`}>{copy.nav.journal}</a>
          </nav>
          <a class="button" href={`${home}#acompanhar`}>
            {copy.nav.cta}
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });
    document.addEventListener('pointerdown', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.removeAttribute('open');
      }
    });
  });
</script>
