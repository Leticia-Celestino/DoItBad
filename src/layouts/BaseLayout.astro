---
import '@fontsource-variable/quicksand';
import '@fontsource-variable/inter';
import '../styles/global.css';
import type { Locale } from '../i18n/config';
import CharacterSketch from '../components/CharacterSketch.astro';
import { getPageCopy } from '../i18n/pages';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  cinematicIntro?: boolean;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const {
  locale,
  title,
  description,
  cinematicIntro = false,
  type = 'website',
  structuredData,
} = Astro.props;
const pages = getPageCopy(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const alternates = [
  ['pt-BR', 'pt-br'],
  ['en', 'en'],
  ['es', 'es'],
  ['de', 'de'],
] as const;
const localePath = (target: string) =>
  Astro.url.pathname.replace(/^\/(pt-br|en|es|de)(?=\/)/, `/${target}`);
const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DoItBad',
  url: new URL(`/${locale}/`, Astro.site).href,
  inLanguage: locale,
};
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4ede1" />
    <meta name="color-scheme" content="light dark" />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternates.map(([language, path]) => (
      <link rel="alternate" hreflang={language} href={new URL(localePath(path), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('pt-br'), Astro.site)} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={locale === 'pt-br' ? 'pt_BR' : locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-image.svg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.svg', Astro.site)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData ?? defaultStructuredData).replace(/</g, '\\u003c')}
    />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('doitbad-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div
      class:list={['intro-curtain', { 'intro-curtain--cinematic': cinematicIntro }]}
      aria-hidden="true"
    >
      <div class="intro-curtain__scene">
        <span class="intro-curtain__mark">
          DoIt<span class="brand-b">B</span>ad<i>✦</i>
        </span>
        <span class="intro-curtain__whisper" lang="pt-BR">
          peraí…
        </span>
        <div class="intro-curtain__character">
          <CharacterSketch />
        </div>
        <div class="intro-curtain__edge"></div>
      </div>
    </div>
    <a class="skip-link" href="#conteudo">
      {pages.skip}
    </a>
    <slot />
    <script is:inline>
      const syncTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#171c19' : '#f4ede1');
        document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
          const isDark = theme === 'dark';
          button.setAttribute('aria-pressed', String(isDark));
          button.setAttribute(
            'aria-label',
            isDark ? button.dataset.labelLight : button.dataset.labelDark,
          );
          button.querySelector('[data-theme-label]').textContent = isDark
            ? button.dataset.valueLight
            : button.dataset.valueDark;
        });
      };
      syncTheme(document.documentElement.dataset.theme);
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          localStorage.setItem('doitbad-theme', next);
          syncTheme(next);
        });
      });

      document.documentElement.classList.add('js');
      const revealItems = document.querySelectorAll('[data-reveal]');
      if (
        'IntersectionObserver' in window &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12 },
        );
        revealItems.forEach((item) => revealObserver.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('.hero-art').forEach((art) => {
          art.addEventListener('pointermove', (event) => {
            const bounds = art.getBoundingClientRect();
            const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 2;
            const y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 2;
            art.style.setProperty('--pointer-x', `${x.toFixed(3)}`);
            art.style.setProperty('--pointer-y', `${y.toFixed(3)}`);
          });
          art.addEventListener('pointerleave', () => {
            art.style.setProperty('--pointer-x', '0');
            art.style.setProperty('--pointer-y', '0');
          });
        });
      }
      const introSeen = sessionStorage.getItem('doitbad-intro-seen');
      const replayIntro = new URLSearchParams(location.search).get('intro') === '1';
      if ((!replayIntro && introSeen) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.body.classList.add('intro-skip');
      } else {
        sessionStorage.setItem('doitbad-intro-seen', 'true');
      }
      requestAnimationFrame(() => {
        requestAnimationFrame(() => document.body.classList.add('is-ready'));
      });
    </script>
  </body>
</html>
