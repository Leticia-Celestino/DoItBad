# Previews remain noindex. Enable only after production review.
PUBLIC_ALLOW_INDEXING=false

# Public key rendered in the browser.
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only variables used by /api/waitlist. Never prefix these with PUBLIC_.
TURNSTILE_SECRET_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=DoItBad <novidades@doitbad.tech>
RESEND_REPLY_TO=contato@doitbad.tech
WAITLIST_RATE_LIMIT_SALT=
PUBLIC_SITE_URL=https://doitbad.tech
TURNSTILE_ALLOWED_HOSTNAMES=doitbad.tech,www.doitbad.tech

# Public, read-only Sanity dataset used during the static build. When omitted,
# the versioned local articles remain the safe fallback.
PUBLIC_SANITY_PROJECT_ID=xqfqfioy
PUBLIC_SANITY_DATASET=production
# Preview deployments only. Never prefix the token with PUBLIC_.
SANITY_PREVIEW=false
SANITY_API_READ_TOKEN=
